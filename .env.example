# Clerk (Primary domain app)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx_or_pk_test_xxx
CLERK_SECRET_KEY=sk_live_xxx_or_sk_test_xxx

# Optional: Clerk custom routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk multi-domain / satellites
# Set these only on satellite apps (NOT on primary) or via Vercel env per-domain:
# CLERK_DOMAIN=www.xencolabs.com
# CLERK_IS_SATELLITE=true
# CLERK_PROXY_URL=https://clerk.xencolabs.com

# Neon Postgres
DATABASE_URL=postgres://user:password@ep-xxxxx.neon.tech/dbname?sslmode=require

# Thesys C1 (GenUI) — optional
NEXT_PUBLIC_THESYS_API_KEY=sk_c1_xxx

# Access link generator (/admin/tokens) — required only if issuing gated-document links.
# ACCESS_TOKEN_SECRET signs the magic links; rotating it invalidates every issued link.
# ADMIN_PASSWORD is a second gate on top of Clerk, since public sign-up is enabled.
ACCESS_TOKEN_SECRET=long_random_string_min_32_chars
ADMIN_PASSWORD=choose_a_strong_shared_password

# Base URL used when building magic links (defaults to https://xencolabs.com)
NEXT_PUBLIC_SITE_URL=https://xencolabs.com

# Public-form bot hardening (advisory briefing form). See FORM_BOT_HARDENING_BRIEF.
# FORM_TOKEN_SECRET: HMAC secret for the signed-timestamp timing floor (required;
#   without it the timing layer is inactive and logs a warning).
FORM_TOKEN_SECRET=long_random_string_min_32_chars
# Cloudflare Turnstile — create a widget for xencolabs.com in the Cloudflare
# dashboard, then set both. Turnstile enforcement turns on automatically once
# TURNSTILE_SECRET_KEY is present; the widget renders when the site key is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA_site_key
TURNSTILE_SECRET_KEY=0x4AAAAAAA_secret_key

# SMTP — powers /api/growth-audit and /api/advisory-briefing notifications.
# If unset, submissions still persist to the database (email is skipped).
SMTP_HOST=mail.xencolabs.com
SMTP_PORT=465
SMTP_USER=notifications@xencolabs.com
SMTP_PASS=your_smtp_password
SMTP_FROM=notifications@xencolabs.com

# Mautic enrollment for /advisory briefing requests (best-effort; OAuth2
# client_credentials against the public instance). Sourced from the Infisical
# xencolabs-fe-site vault (a NEW XL credential pair — never ResumeCoach's).
# Leave unset to skip enrollment without affecting Neon capture + email notify.
MAUTIC_URL=https://mautic.xencolabs.com
MAUTIC_OAUTH_TOKEN_URL=https://mautic.xencolabs.com/oauth/v2/token
XENCOLABS_MAUTIC_PUBLIC_KEY=oauth2_client_id
XENCOLABS_MAUTIC_SECRET_KEY=oauth2_client_secret

# ── Blog / Payload CMS (Editorial Block System) ──────────────────────────────
# Payload CMS base URL used to fetch article bodies + resolve media.
CMS_URL=https://cms.xencolabs.com
NEXT_PUBLIC_PAYLOAD_URL=https://cms.xencolabs.com
# Exact Payload site slug — drives article queries AND the Meili `site` filter.
NEXT_PUBLIC_SITE_SLUG=xencolabs
# Payload REST API key. /api/articles is AUTH-GATED — anonymous reads return
# blank. Sent as `Authorization: users API-Key <CMS_API_KEY>`. MUST be
# provisioned in the vault (do NOT commit a value).
CMS_API_KEY=payload_users_api_key
# MeiliSearch (blog search) — search-scoped key, already in the deploy env.
MEILISEARCH_HOST=https://search.xencolabs.com
MEILISEARCH_API_KEY=meili_search_scoped_key
# Optional override; defaults to "articles".
MEILISEARCH_ARTICLES_INDEX=articles

# Private npm registry token for @xenco/editorial-blocks (referenced by .npmrc
# as ${NPM_TOKEN}; set in CI/Vercel env, never committed).
NPM_TOKEN=base64_registry_auth
